<div class="sheet monster">
<section class="page">
  <h1 class="mname">{{name}}</h1>
  <div class="mtop">
    <div class="statcol">
      <div class="typeline">{{typeLine}}</div>
      <table class="stat">
        <tr><th>{{axpT "Hit Dice:"}}</th><td>{{hitDice}}</td></tr>
        <tr><th>{{axpT "Initiative:"}}</th><td>{{initiative}}</td></tr>
        <tr><th>{{axpT "Speed:"}}</th><td>{{speedLine}}</td></tr>
        <tr><th>{{axpT "Armor Class:"}}</th><td>{{acLine}}</td></tr>
        <tr><th>{{axpT "Base Attack/Grapple:"}}</th><td>{{babGrapple}}</td></tr>
        <tr><th>{{axpT "Attack:"}}</th><td>{{attackLine}}</td></tr>
        <tr><th>{{axpT "Full Attack:"}}</th><td>{{fullAttackLine}}</td></tr>
        <tr><th>{{axpT "Space/Reach:"}}</th><td>{{spaceReach}}</td></tr>
        <tr><th>{{axpT "Special Attacks:"}}</th><td>{{specialAttacks}}</td></tr>
        <tr><th>{{axpT "Special Qualities:"}}</th><td>{{specialQualities}}</td></tr>
        <tr><th>{{axpT "Saves:"}}</th><td>{{savesLine}}</td></tr>
        <tr><th>{{axpT "Abilities:"}}</th><td>{{abilitiesLine}}</td></tr>
        <tr><th>{{axpT "Skills:"}}</th><td>{{skillsLine}}</td></tr>
        <tr><th>{{axpT "Feats:"}}</th><td>{{featsLine}}</td></tr>
        <tr><th>{{axpT "Languages:"}}</th><td>{{languagesLine}}</td></tr>
      </table>
      <table class="stat eco">
        <tr><th>{{axpT "Environment:"}}</th><td>{{environment}}</td></tr>
        <tr><th>{{axpT "Organization:"}}</th><td>{{organization}}</td></tr>
        <tr><th>{{axpT "Challenge Rating:"}}</th><td>{{cr}}</td></tr>
        <tr><th>{{axpT "Treasure:"}}</th><td>{{treasure}}</td></tr>
        <tr><th>{{axpT "Alignment:"}}</th><td>{{alignmentLine}}</td></tr>
        <tr><th>{{axpT "Advancement:"}}</th><td>{{advancement}}</td></tr>
        <tr><th>{{axpT "Level Adjustment:"}}</th><td>{{levelAdjustment}}</td></tr>
      </table>
    </div>
    {{#if img}}<div class="mportrait"><img src="{{img}}" alt=""></div>{{/if}}
  </div>

  {{{companionBox}}}

  {{#if isCaster}}
  {{#each spellbooks}}
  <div class="mspells"><b>{{name}}</b> {{axpT "(CL {cl}):" cl=casterLevel}}
    {{#each activeLevels}}<span class="slvl"><b>{{level}}{{#if perDay}} {{axpT "({n}/day)" n=perDay}}{{/if}}</b>&mdash;{{#each spells}}{{name}}{{#unless @last}}, {{/unless}}{{else}}&nbsp;{{/each}}{{#if spells.length}} {{axpT "(DC {dc})" dc=dc}}{{/if}}</span>{{/each}}
  </div>
  {{/each}}
  {{/if}}

  {{#if description}}<div class="mdesc">{{{description}}}</div>{{/if}}
  {{#if notes}}<div class="mdesc notes">{{{notes}}}</div>{{/if}}
  <p class="printed">{{axpT "Printed {date} from Foundry VTT" date=printedOn}}</p>
</section>
</div>
