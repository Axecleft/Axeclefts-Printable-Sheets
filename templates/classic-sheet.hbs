<div class="sheet classic">
<!-- =================== PAGE 1: character, abilities, combat, skills =================== -->
<section class="page">
  <div class="title">{{axpT "Character Record"}} <span>{{axpT "3.5 Edition Rules"}}</span></div>
  <div class="idrow">
    <div class="fld" style="flex:3"><span>{{name}}</span><label>{{axpT "Character Name"}}</label></div>
    <div class="fld" style="flex:2"><span>&nbsp;</span><label>{{axpT "Player"}}</label></div>
  </div>
  <div class="idrow">
    <div class="fld" style="flex:3"><span>{{classLine}}</span><label>{{axpT "Class and Level"}}</label></div>
    <div class="fld"><span>{{race}}</span><label>{{axpT "Race"}}</label></div>
    <div class="fld"><span>{{alignment}}</span><label>{{axpT "Alignment"}}</label></div>
    <div class="fld"><span>{{deity}}</span><label>{{axpT "Deity"}}</label></div>
  </div>
  <div class="idrow">
    <div class="fld"><span>{{size}}</span><label>{{axpT "Size"}}</label></div>
    <div class="fld"><span>{{age}}</span><label>{{axpT "Age"}}</label></div>
    <div class="fld"><span>{{gender}}</span><label>{{axpT "Gender"}}</label></div>
    <div class="fld"><span>{{height}}</span><label>{{axpT "Height"}}</label></div>
    <div class="fld"><span>{{weight}}</span><label>{{axpT "Weight"}}</label></div>
    <div class="fld"><span>&nbsp;</span><label>{{axpT "Eyes"}}</label></div>
    <div class="fld"><span>&nbsp;</span><label>{{axpT "Hair"}}</label></div>
    <div class="fld"><span>&nbsp;</span><label>{{axpT "Skin"}}</label></div>
  </div>

  <div class="top">
    <table class="abil">
      <tr class="lbl"><td>{{{axpT "Ability<br>Name"}}}</td><td>{{{axpT "Ability<br>Score"}}}</td><td>{{{axpT "Ability<br>Modifier"}}}</td><td>{{{axpT "Temporary<br>Score"}}}</td><td>{{{axpT "Temporary<br>Modifier"}}}</td></tr>
      {{#each abilities}}
      <tr><th class="tab">{{abbr}}<small>{{label}}</small></th><td class="b">{{score}}</td><td class="b">{{mod}}</td><td class="b t">{{tempScore}}</td><td class="b t">{{tempMod}}</td></tr>
      {{/each}}
    </table>

    <div class="vitals">
      <div class="line">
        <div class="tab">{{axpT "HP"}}<small>{{axpT "Hit Points"}}</small></div>
        <div class="cell"><div class="b big">{{hp.max}}</div><label>{{axpT "Total"}}</label></div>
        <div class="cell grow"><div class="b wide t">&nbsp;</div><label>{{axpT "Wounds / Current HP"}}</label></div>
        <div class="cell"><div class="b t">{{hp.nonlethal}}</div><label>{{axpT "Nonlethal Damage"}}</label></div>
        <div class="cell"><div class="b">{{speed}}</div><label>{{axpT "Speed"}}</label></div>
      </div>
      <div class="line">
        <div class="tab">{{axpT "AC"}}<small>{{axpT "Armor Class"}}</small></div>
        <div class="cell"><div class="b big">{{ac.total}}</div><label>{{axpT "Total"}}</label></div><span class="op">= 10 +</span>
        <div class="cell"><div class="b">{{ac.armor}}</div><label>{{axpT "Armor Bonus"}}</label></div><span class="op">+</span>
        <div class="cell"><div class="b">{{ac.shield}}</div><label>{{axpT "Shield Bonus"}}</label></div><span class="op">+</span>
        <div class="cell"><div class="b">{{ac.dex}}</div><label>{{axpT "Dex Modifier"}}</label></div><span class="op">+</span>
        <div class="cell"><div class="b">{{ac.size}}</div><label>{{axpT "Size Modifier"}}</label></div><span class="op">+</span>
        <div class="cell"><div class="b">{{ac.natural}}</div><label>{{axpT "Natural Armor"}}</label></div><span class="op">+</span>
        <div class="cell"><div class="b t">&nbsp;</div><label>{{axpT "Deflection Modifier"}}</label></div><span class="op">+</span>
        <div class="cell"><div class="b">{{ac.misc}}</div><label>{{axpT "Misc Modifier"}}</label></div>
      </div>
      <div class="line">
        <div class="tab sm">{{axpT "Touch"}}<small>{{axpT "Armor Class"}}</small></div><div class="b">{{ac.touch}}</div>
        <div class="tab sm">{{axpT "Flat-Footed"}}<small>{{axpT "Armor Class"}}</small></div><div class="b">{{ac.flatFooted}}</div>
        <div class="cell grow"><div class="b wide">{{dr}}</div><label>{{axpT "Damage Reduction"}}</label></div>
      </div>
      <div class="line">
        <div class="tab">{{axpT "Initiative"}}<small>{{axpT "Modifier"}}</small></div>
        <div class="cell"><div class="b big">{{init.total}}</div><label>{{axpT "Total"}}</label></div><span class="op">=</span>
        <div class="cell"><div class="b">{{init.dex}}</div><label>{{axpT "Dex Modifier"}}</label></div><span class="op">+</span>
        <div class="cell"><div class="b">{{init.misc}}</div><label>{{axpT "Misc Modifier"}}</label></div>
      </div>
    </div>
  </div>

  <div class="cols">
    <div class="left">
      <table class="saves">
        <tr class="lbl"><td>{{axpT "Saving Throws"}}</td><td>{{axpT "Total"}}</td><td></td><td>{{{axpT "Base<br>Save"}}}</td><td></td><td>{{{axpT "Ability<br>Modifier"}}}</td><td></td><td>{{{axpT "Magic<br>Modifier"}}}</td><td></td><td>{{{axpT "Misc<br>Modifier"}}}</td><td></td><td>{{{axpT "Temporary<br>Modifier"}}}</td></tr>
        {{#each saves}}
        <tr><th class="tab">{{label}}<small>({{ability}})</small></th><td class="b big">{{total}}</td><td class="op">=</td><td class="b">{{base}}</td><td class="op">+</td>
            <td class="b">{{mod}}</td><td class="op">+</td><td class="b t">&nbsp;</td><td class="op">+</td><td class="b">{{misc}}</td><td class="op">+</td><td class="b t">&nbsp;</td></tr>
        {{/each}}
      </table>
      <div class="cond">{{axpT "Conditional modifiers:"}}</div>

      <div class="line atk">
        <div class="tab">{{axpT "Base Attack"}}<small>{{axpT "Bonus"}}</small></div><div class="b wide">{{bab}}</div>
        <div class="tab">{{axpT "Spell"}}<small>{{axpT "Resistance"}}</small></div><div class="b">{{sr}}</div>
      </div>
      {{#with grapple}}
      <div class="line atk">
        <div class="tab">{{axpT "Grapple"}}<small>{{axpT "Modifier"}}</small></div>
        <div class="cell"><div class="b big">{{total}}</div><label>{{axpT "Total"}}</label></div><span class="op">=</span>
        <div class="cell"><div class="b">{{bab}}</div><label>{{axpT "Base Attack Bonus"}}</label></div><span class="op">+</span>
        <div class="cell"><div class="b">{{ability}}</div><label>{{axpT "Strength Modifier"}}</label></div><span class="op">+</span>
        <div class="cell"><div class="b">{{size}}</div><label>{{axpT "Size Modifier"}}</label></div><span class="op">+</span>
        <div class="cell"><div class="b">{{misc}}</div><label>{{axpT "Misc Modifier"}}</label></div>
      </div>
      {{/with}}

      {{#each weaponBlocks}}
      <table class="weapon">
        <tr class="lbl"><td class="nm">{{axpT "Attack"}}</td><td>{{axpT "Total Attack Bonus"}}</td><td>{{axpT "Damage"}}</td><td>{{axpT "Critical"}}</td></tr>
        <tr><td class="nm v">{{#unless blank}}{{name}}{{/unless}}</td><td class="v">{{attack}}</td><td class="v">{{damage}}</td><td class="v">{{critical}}</td></tr>
        <tr class="lbl"><td>{{axpT "Range"}}</td><td>{{axpT "Type"}}</td><td colspan="2">{{axpT "Notes"}}</td></tr>
        <tr><td class="v">{{range}}</td><td class="v">{{type}}</td><td class="v" colspan="2">{{special}}</td></tr>
        <tr><td class="ammo" colspan="4">{{axpT "Ammunition"}} <span class="ticks">&#9633;&#9633;&#9633;&#9633;&#9633; &#9633;&#9633;&#9633;&#9633;&#9633; &#9633;&#9633;&#9633;&#9633;&#9633; &#9633;&#9633;&#9633;&#9633;&#9633;</span></td></tr>
      </table>
      {{/each}}
    </div>

    <div class="right">
      <div class="sechead">{{axpT "Skills"}} <span>{{axpT "Max Ranks {max} / {cross}" max=maxRanks cross=maxCrossRanks}}</span></div>
      <table class="skills">
        <tr class="lbl"><td>{{{axpT "Class<br>Skill"}}}</td><td class="sn">{{axpT "Skill Name"}}</td><td>{{{axpT "Key<br>Ability"}}}</td><td>{{{axpT "Skill<br>Modifier"}}}</td><td></td><td>{{{axpT "Ability<br>Modifier"}}}</td><td></td><td>{{axpT "Ranks"}}</td><td></td><td>{{{axpT "Misc<br>Modifier"}}}</td></tr>
        {{#each skills}}
        <tr class="{{#if untrainedNoUse}}dim{{/if}}"><td>{{#if classSkill}}&#9632;{{else}}&#9633;{{/if}}</td>
          <td class="sn">{{name}}{{#if trainedOnly}}<sup>&#9670;</sup>{{/if}}{{#if acp}}*{{/if}}</td><td>{{ability}}</td>
          <td class="tot">{{total}}</td><td class="op">=</td><td>{{abilityMod}}</td><td class="op">+</td><td>{{rank}}</td><td class="op">+</td><td>{{misc}}</td></tr>
        {{/each}}
      </table>
      <p class="foot">{{axpT "◆ Skill can be used only if the character has at least 1 rank. * Armor check penalty applies (double for Swim)."}}</p>
    </div>
  </div>
</section>

<!-- =================== PAGE 2: protection, possessions, feats, abilities =================== -->
<section class="page">
  <div class="cols2">
    <div>
      {{#each protectionBlocks}}
      <table class="prot">
        <tr class="lbl"><td class="nm">{{#if blank}}{{axpT "Armor / Protective Item"}}{{else}}{{kind}}{{/if}}</td><td>{{axpT "Type"}}</td><td>{{axpT "AC Bonus"}}</td><td>{{axpT "Max Dex"}}</td></tr>
        <tr><td class="nm v">{{name}}</td><td class="v">{{type}}</td><td class="v">{{bonus}}</td><td class="v">{{maxDex}}</td></tr>
        <tr class="lbl"><td>{{axpT "Check Penalty"}}</td><td>{{axpT "Spell Failure"}}</td><td>{{axpT "Speed"}}</td><td>{{axpT "Weight"}}</td></tr>
        <tr><td class="v">{{checkPenalty}}</td><td class="v">{{spellFailure}}</td><td class="v">{{speed}}</td><td class="v">{{weight}}</td></tr>
        <tr><td class="v sp" colspan="4"><label>{{axpT "Special Properties"}}</label></td></tr>
      </table>
      {{/each}}
    </div>
    <div>
      <div class="sechead">{{axpT "Possessions"}}</div>
      <div class="poss">
        <table class="list"><tr class="lbl"><td class="nm">{{axpT "Item"}}</td><td>{{axpT "Qty"}}</td><td>{{axpT "Wt."}}</td></tr>
          {{#each gearLines}}<tr><td class="nm">{{name}}</td><td>{{#unless blank}}{{qty}}{{/unless}}</td><td>{{weight}}</td></tr>{{/each}}
        </table>
      </div>
      <div class="line tw"><span>{{axpT "Total Weight Carried"}}</span><div class="b wide">{{carried}} {{axpT "lb."}}</div></div>
    </div>
  </div>

  <table class="load">
    <tr><td class="b">{{loads.light}} {{axpT "lb."}}</td><td class="b">{{loads.medium}} {{axpT "lb."}}</td><td class="b">{{loads.heavy}} {{axpT "lb."}}</td>
        <td class="b">{{lifts.overHead}} {{axpT "lb."}}</td><td class="b">{{lifts.offGround}} {{axpT "lb."}}</td><td class="b">{{lifts.drag}} {{axpT "lb."}}</td></tr>
    <tr class="lbl"><td>{{axpT "Light Load"}}</td><td>{{axpT "Medium Load"}}</td><td>{{axpT "Heavy Load"}}</td><td>{{{axpT "Lift Over Head<br>(= max load)"}}}</td><td>{{{axpT "Lift Off Ground<br>(2 × max load)"}}}</td><td>{{{axpT "Push or Drag<br>(5 × max load)"}}}</td></tr>
  </table>

  <div class="cols3">
    <div><div class="sechead">{{axpT "Feats"}}</div><ul class="lines">{{#each featLines}}<li>{{name}}&nbsp;</li>{{/each}}</ul></div>
    <div><div class="sechead">{{axpT "Special Abilities"}}</div><ul class="lines">{{#each featureLines}}<li{{#if header}} class="grp"{{/if}}>{{name}}&nbsp;</li>{{/each}}</ul></div>
    <div>
      <div class="sechead">{{axpT "Languages"}}</div><ul class="lines">{{#each languageLines}}<li>{{name}}&nbsp;</li>{{/each}}</ul>
      <div class="sechead">{{axpT "Money"}}</div>
      <table class="money"><tr><th>{{axpT "CP"}}</th><td>{{money.cp}}</td></tr><tr><th>{{axpT "SP"}}</th><td>{{money.sp}}</td></tr>
        <tr><th>{{axpT "GP"}}</th><td>{{money.gp}}</td></tr><tr><th>{{axpT "PP"}}</th><td>{{money.pp}}</td></tr></table>
      <div class="sechead">{{axpT "Experience Points"}}</div>
      <div class="xp"><div class="b wide">{{xp}}</div><label>{{axpT "Next level: {xp}" xp=xpNext}}</label></div>
    </div>
  </div>
</section>

{{#if isCaster}}
<!-- =================== PAGE 3: spells (casters only); each spellbook starts its own page =================== -->
{{#each spellbooks}}
{{#each spellPages}}
<section class="page">
  {{#if first}}
  {{#if ../psionic}}
  <div class="sechead">{{../name}} <span>{{axpT "Manifester level {cl}" cl=../casterLevel}} &middot; {{../ability}} {{../abilityMod}}{{#if ../concentration}} &middot; {{axpT "Concentration {n}" n=../concentration}}{{/if}}</span></div>
  <div class="spelltop">
    <table class="slots">
      <tr class="lbl"><td>{{{axpT "Powers<br>Known"}}}</td><td>{{{axpT "Power<br>Save DC"}}}</td><td>{{axpT "Level"}}</td><td>{{{axpT "Power<br>Point Cost"}}}</td></tr>
      {{#each ../psiLevels}}
      <tr><td class="b">{{known}}</td><td class="b">{{dc}}</td><td class="lv">{{level}}</td><td class="b">{{ppCost}}</td></tr>
      {{/each}}
    </table>
    <div class="spellnotes">
      <div class="line"><span class="tab sm">{{axpT "Power Points"}}<small>{{axpT "per day"}}</small></span><div class="b big">{{../powerPoints}}</div><div class="cell grow"><div class="b t">&nbsp;</div><label>{{axpT "Points left"}}</label></div></div>
      <div class="fld"><span>{{axpT "{n} powers known, up to level {max}" n=../powersKnown max=../maxPowerLevel}}</span><label>{{axpT "Powers Known"}}</label></div>
      <div class="fld"><span>&nbsp;</span><label>{{axpT "Discipline / Conditional Modifiers"}}</label></div>
    </div>
  </div>
  {{else}}
  <div class="sechead">{{../name}} <span>{{axpT "Caster level {cl}" cl=../casterLevel}} &middot; {{../ability}} {{../abilityMod}}{{#if ../concentration}} &middot; {{axpT "Concentration {n}" n=../concentration}}{{/if}}{{#if ../spontaneous}} &middot; {{axpT "Spontaneous"}}{{/if}}</span></div>
  <div class="spelltop">
    <table class="slots">
      <tr class="lbl"><td>{{{axpT "Spells<br>Known"}}}</td><td>{{{axpT "Spell<br>Save DC"}}}</td><td>{{axpT "Level"}}</td><td>{{{axpT "Spells<br>per Day"}}}</td><td>{{{axpT "Bonus<br>Spells"}}}</td></tr>
      {{#each ../levels}}
      <tr><td class="b">{{known}}</td><td class="b">{{dc}}</td><td class="lv">{{level}}</td><td class="b">{{perDay}}</td><td class="b">{{bonus}}</td></tr>
      {{/each}}
    </table>
    <div class="spellnotes">
      <div class="fld"><span>&nbsp;</span><label>{{axpT "Domains / Specialty School"}}</label></div>
      <div class="fld"><span>&nbsp;</span><label>{{axpT "Conditional Modifiers"}}</label></div>
      <div class="fld"><span>{{@root.spellFailure}}%</span><label>{{axpT "Arcane Spell Failure"}}</label></div>
    </div>
  </div>
  {{/if}}
  {{else}}
  <div class="sechead">{{../name}} <span>{{axpT "continued"}}</span></div>
  {{/if}}
  <div class="spellcols">
    {{#each columns}}
    <div class="spellcol">
      {{#each this}}
      <div class="slv"><div class="slvh">{{axpT "Level {n}" n=level}}{{#if cont}} <span class="cont">{{axpT "(continued)"}}</span>{{/if}}</div>
        <ul>{{#each lines}}<li>{{#if blank}}&nbsp;{{else}}&#9633; {{name}}{{#if prepared}} &times;{{prepared}}{{/if}}{{/if}}</li>{{/each}}</ul></div>
      {{/each}}
    </div>
    {{/each}}
  </div>
</section>
{{/each}}
{{/each}}
{{/if}}
</div>
